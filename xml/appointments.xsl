<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform"><xsl:output method="html" indent="yes"/><xsl:template match="/"><html><head><title>Salon Appointment Report</title><style>body{font-family:Arial;margin:30px;background:#faf8fc;color:#282432}h1{color:#7952a5}table{border-collapse:collapse;width:100%;background:white}th,td{border:1px solid #ded5e7;padding:10px;text-align:left}th{background:#7952a5;color:white}tr:nth-child(even){background:#f5effa}</style></head><body><h1>Salon Appointment Report</h1><p>Records sorted by customer name in ascending order.</p><table><tr><th>Customer</th><th>Phone</th><th>Gender</th><th>Service</th><th>Stylist</th><th>Date</th><th>Time slot</th></tr><xsl:for-each select="appointments/appointment"><xsl:sort select="customerName" order="ascending"/><tr><td><xsl:value-of select="customerName"/></td><td><xsl:value-of select="phone"/></td><td><xsl:value-of select="gender"/></td><td><xsl:value-of select="service"/></td><td><xsl:value-of select="stylist"/></td><td><xsl:value-of select="date"/></td><td><xsl:value-of select="timeSlot"/></td></tr></xsl:for-each></table></body></html></xsl:template></xsl:stylesheet>